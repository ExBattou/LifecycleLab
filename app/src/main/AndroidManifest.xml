<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".LifecycleApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.LifecycleLab">

        <!-- Actividad Principal (El Laboratorio) -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="true"
            android:label="@string/title_main">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Segunda Actividad: Pantalla completa (provoca onPause -> onStop en MainActivity) -->
        <activity
            android:name=".activities.SecondActivity"
            android:exported="false"
            android:label="@string/title_second" />

        <!-- Actividad Diálogo Translúcida: Clave pedagógica (provoca onPause SIN onStop en MainActivity) -->
        <activity
            android:name=".activities.DialogActivity"
            android:exported="false"
            android:label="@string/title_dialog"
            android:theme="@style/Theme.LifecycleLab.Dialog" />

        <!-- Visor del archivo TXT con botón para compartir / exportar -->
        <activity
            android:name=".activities.LogViewerActivity"
            android:exported="false"
            android:label="@string/title_logs" />

        <!-- Guía Teórica didáctica de los ciclos de vida -->
        <activity
            android:name=".activities.TheoryActivity"
            android:exported="false"
            android:label="@string/title_theory" />

        <!-- FileProvider para compartir con seguridad el archivo lifecycle_log.txt sin exponer FileUri -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
